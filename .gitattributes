# Force LF line endings for all shell scripts and text files
# — prevents CRLF conversion on Windows which breaks exec in Linux containers

* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.env text eol=lf
*.env.* text eol=lf
Dockerfile text eol=lf
