# Application
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Seed data
# Password for the admin@bmg.example.com account created on first run.
# Set SEED_SKIP=1 to skip seeding entirely.
SEED_ADMIN_PASSWORD=Admin1234!

# Database
POSTGRES_DB=cyberops
POSTGRES_USER=cyberops
POSTGRES_PASSWORD=cyberops_dev
DATABASE_URL=postgresql+asyncpg://cyberops:cyberops_dev@db:5432/cyberops

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Wazuh Integration (leave blank to disable — all fields optional)
# WAZUH_URL=https://wazuh-manager:55000
# WAZUH_USER=wazuh-wui
# WAZUH_PASSWORD=changeme
# WAZUH_VERIFY_TLS=true   # set false only for self-signed certs in dev/test
# WAZUH_INGEST_SECRET=change-this-shared-secret  # used by POST /wazuh/{org_id}/ingest
# WAZUH_POLL_INTERVAL_SECONDS=60
