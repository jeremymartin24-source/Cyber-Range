# ══════════════════════════════════════════════════════════════════
#  CyberOps Range — Production Environment Template
#  Copy to .env.production and fill in every value before deploying.
#
#  Generate secrets with:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
#    openssl rand -hex 32
# ══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
# REQUIRED: generate a unique 32-byte hex secret
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_64_HEX_CHARS

ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=cyberops
POSTGRES_USER=cyberops
# REQUIRED: strong password — no special chars that break connection strings
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Constructed from the three vars above by docker-compose.prod.yml
# DATABASE_URL is set automatically — do not set it here

# ── Redis ────────────────────────────────────────────────────────
# REQUIRED: Redis password (requirepass is set in prod compose)
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# These are set by the compose file using REDIS_PASSWORD
# REDIS_URL / CELERY_BROKER_URL / CELERY_RESULT_BACKEND are auto-set

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────
# Replace with your actual domain — no trailing slash
ALLOWED_ORIGINS=https://cyberops.yourdomain.com

# ── Public URL (used by the frontend) ────────────────────────────
PUBLIC_URL=https://cyberops.yourdomain.com
NEXT_PUBLIC_API_URL=https://cyberops.yourdomain.com

# ── Seed admin account ───────────────────────────────────────────
# !! CHANGE THIS IMMEDIATELY AFTER FIRST LOGIN !!
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ── Wazuh Integration (optional — leave blank to disable) ────────
# WAZUH_URL=https://wazuh-manager:55000
# WAZUH_USER=wazuh-wui
# WAZUH_PASSWORD=changeme
# WAZUH_VERIFY_TLS=true
# WAZUH_INGEST_SECRET=REPLACE_WITH_GENERATED_SECRET
# WAZUH_POLL_INTERVAL_SECONDS=60

# ══════════════════════════════════════════════════════════════════
#  SECURITY CHECKLIST
#  □ SECRET_KEY is unique and cryptographically random
#  □ POSTGRES_PASSWORD is strong and not reused elsewhere
#  □ REDIS_PASSWORD is set (Redis is otherwise unauthenticated)
#  □ SEED_ADMIN_PASSWORD is changed after first login
#  □ ALLOWED_ORIGINS contains only your actual domain
#  □ TLS certificates are placed in nginx/certs/ (not self-signed)
#  □ .env.production is in .gitignore and never committed
#  □ docker-compose.prod.yml internal: true isolates DB/Redis
# ══════════════════════════════════════════════════════════════════
